# ============================================================
# FullMoon — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# Ne jamais commiter .env.local dans le repo Git
# ============================================================

# ------------------------------------------------------------
# URL du serveur Socket.io
# Décommenter la ligne correspondant à votre contexte
# ------------------------------------------------------------

# Dev local (par défaut)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Dev Wi-Fi local (remplacer par votre IP)
# NEXT_PUBLIC_SOCKET_URL=http://192.168.X.X:3001

# Dev Wi-Fi avec partage USB (IP attribuée par le téléphone)
# NEXT_PUBLIC_SOCKET_URL=http://10.X.X.X:3001

# Tunnel distant (ngrok ou équivalent)
# NEXT_PUBLIC_SOCKET_URL=https://xxxx-xxxx.ngrok-free.app

# Production
# NEXT_PUBLIC_SOCKET_URL=https://votre-domaine.com

# ------------------------------------------------------------
# CORS — Origines autorisées côté serveur Socket.io
# Séparer plusieurs origines par des virgules
# ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# Exemple production :
# ALLOWED_ORIGINS=https://votre-domaine.com,http://localhost:3000

# ------------------------------------------------------------
# Serveur TURN WebRTC (optionnel)
# Si absent, utilise le fallback gratuit openrelay.metered.ca
# Pour supprimer la dépendance au TURN public, installer coturn
# sur votre VPS et renseigner les valeurs ci-dessous
# ------------------------------------------------------------
# NEXT_PUBLIC_TURN_URL=turn:votre-serveur.com:3478
# NEXT_PUBLIC_TURN_USERNAME=votre_username
# NEXT_PUBLIC_TURN_CREDENTIAL=votre_password

# ------------------------------------------------------------
# Emails administrateurs — panel de debug WebRTC
# Séparés par des virgules, visible uniquement pour ces comptes
# ------------------------------------------------------------
# NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com,autre@example.com

# ------------------------------------------------------------
# Firebase (optionnel si déjà configuré dans lib/firebase.ts)
# ------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=
